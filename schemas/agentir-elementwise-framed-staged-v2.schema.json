{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentir-elementwise-framed-staged-v2.schema.json",
  "title": "AgentIR framed staged authoring response v2",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agentir.elementwise_framed_staged.v2",
      "type": "string"
    },
    "task_id": {"minLength": 1, "type": "string"},
    "frame_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "choices": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "slot": {"minLength": 1, "type": "string"},
          "op": {"enum": ["add", "mul", "fma"], "type": "string"},
          "operands": {
            "items": {"minLength": 1, "type": "string"},
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": ["slot", "op", "operands"],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "state": {"minLength": 1, "type": "string"}
  },
  "required": ["schema", "task_id", "frame_hash", "choices", "state"],
  "type": "object"
}
