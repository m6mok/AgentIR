{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentir-elementwise-authoring-frame-v2.schema.json",
  "title": "AgentIR compiler-owned authoring frame v2",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agentir.elementwise_authoring_frame.v2", "type": "string"},
    "task_id": {"minLength": 1, "type": "string"},
    "frame_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "stages": {"minimum": 1, "type": "integer"},
    "seed_role": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"},
    "roles": {
      "additionalProperties": {"$ref": "#/$defs/role"},
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "type": "object"
    },
    "slots": {
      "items": {"$ref": "#/$defs/slot"},
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "state_candidates": {
      "items": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "expanded_operation_limit": {"const": 128, "type": "integer"}
  },
  "required": ["schema", "task_id", "frame_hash", "stages", "seed_role", "roles", "slots", "state_candidates", "expanded_operation_limit"],
  "type": "object",
  "$defs": {
    "capture": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "scalar", "type": "string"},
            "name": {"minLength": 1, "type": "string"}
          },
          "required": ["kind", "name"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "tensor", "type": "string"},
            "name": {"minLength": 1, "type": "string"}
          },
          "required": ["kind", "name"],
          "type": "object"
        }
      ]
    },
    "role": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "scalar", "type": "string"},
            "name": {"minLength": 1, "type": "string"}
          },
          "required": ["kind", "name"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "tensor", "type": "string"},
            "name": {"minLength": 1, "type": "string"}
          },
          "required": ["kind", "name"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "stage_local", "type": "string"},
            "slot": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"}
          },
          "required": ["kind", "slot"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "state_prev", "type": "string"}
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "state_lag", "type": "string"},
            "stages": {"minimum": 1, "type": "integer"},
            "initial": {"items": {"$ref": "#/$defs/capture"}, "minItems": 1, "type": "array"}
          },
          "required": ["kind", "stages", "initial"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["scalar_cycle", "tensor_cycle"], "type": "string"},
            "prefix": {"type": "string"},
            "count": {"minimum": 1, "type": "integer"},
            "stride": {"minimum": 0, "type": "integer"},
            "offset": {"minimum": 0, "type": "integer"}
          },
          "required": ["kind", "prefix", "count", "stride", "offset"],
          "type": "object"
        }
      ]
    },
    "menu": {
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["add", "mul", "fma"], "type": "string"},
        "operand_roles": {
          "items": {
            "items": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"},
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "maxItems": 3,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": ["op", "operand_roles"],
      "type": "object"
    },
    "slot": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"},
        "menus": {"items": {"$ref": "#/$defs/menu"}, "minItems": 1, "type": "array"}
      },
      "required": ["id", "menus"],
      "type": "object"
    }
  }
}
